# ==========================================================
# HOMESTOCK CONFIGURATION (.env)
# ==========================================================

# Application
APP_NAME=HomeStock
SECRET_KEY=homestock-super-secret-jwt-key-2026-academic-dbms
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MySQL 8.0+ Database Credentials
# The system connects to MySQL by default.
# If MySQL is not running on localhost:3306, it automatically falls back
# to local SQLite engine (homestock.db) without crashing.
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=homestock

# OCR Engine Path (Windows Tesseract OCR default)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
